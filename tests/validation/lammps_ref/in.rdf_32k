# T5: RDF of the 32k LJ melt over 50 000 steps, shift off, same initial state.
# 250 bins on [0, 5]. Samples every 100 steps (500 frames).
units           lj
atom_style      atomic
boundary        p p p
region          sim block 0 1 0 1 0 1
create_box      1 sim
read_dump       init_32k.dump 0 x y z vx vy vz box yes add yes
mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
pair_modify     shift no
neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes
comm_modify     cutoff 5.3
timestep        0.005
fix             1 all nve
compute         rd all rdf 250 cutoff 5.0
fix             rdf all ave/time 100 500 50000 c_rd[*] file rdf_32k.txt mode vector
thermo          10000
run             50000
