# Equilibrated LJ melt, N = 4*10^3 = 4000. Reduced units, shift off.
# Matches PLAN.md section 4.4 except N (fixture size, not the 32k benchmark).
units           lj
atom_style      atomic
boundary        p p p
lattice         fcc 0.8442
region          box block 0 10 0 10 0 10
create_box      1 box
create_atoms    1 box
mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
pair_modify     shift no
velocity        all create 1.44 12345 mom yes rot yes dist gaussian
neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes
timestep        0.005
fix             1 all nve
compute         pvir all pressure NULL virial
variable        wxx equal c_pvir[1]*vol
variable        wyy equal c_pvir[2]*vol
variable        wzz equal c_pvir[3]*vol
variable        wxy equal c_pvir[4]*vol
variable        wxz equal c_pvir[5]*vol
variable        wyz equal c_pvir[6]*vol
thermo          1000
thermo_style    custom step pe v_wxx v_wyy v_wzz v_wxy v_wxz v_wyz
thermo_modify   format float %.16g
run             1000
write_dump      all custom melt_4000.dump id type x y z fx fy fz modify sort id format float %.17g
