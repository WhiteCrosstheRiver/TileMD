# T4: 32k LJ melt, shifted-force, 10^6 NVE steps. Same initial state as init_32k.dump.
# pe, ke, and etotal are per atom under units lj.
units           lj
atom_style      atomic
boundary        p p p
region          sim block 0 1 0 1 0 1
create_box      1 sim
read_dump       init_32k.dump 0 x y z vx vy vz box yes add yes
mass            1 1.0
pair_style      lj/sf 2.5
pair_coeff      1 1 1.0 1.0
neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes
timestep        0.005
fix             1 all nve
thermo          1000
thermo_style    custom step temp pe ke etotal press
thermo_modify   format float %.16g
run             1000000
