# 32k LJ melt, reduced units, shift off. PLAN.md section 4.4 with n = 20.
# The step-0 dump is the shared initial state for the GPU comparison.
# Under units lj, thermo pe and ke are per atom.
units           lj
atom_style      atomic
boundary        p p p
lattice         fcc 0.8442
region          box block 0 20 0 20 0 20
create_box      1 box
create_atoms    1 box
mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
pair_modify     shift no
velocity        all create 1.44 12345 mom yes rot yes dist gaussian
neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes
timestep        0.005
fix             1 all nve
write_dump      all custom init_32k.dump id type x y z vx vy vz modify sort id format float %.17g
thermo          1000
thermo_style    custom step temp pe ke press
thermo_modify   format float %.16g
run             10000
